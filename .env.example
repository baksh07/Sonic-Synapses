# Copy this file to `.env` in the repo root (or the example folder you run from)
# and fill in real values. Never commit `.env`.

# LLM
OPENAI_API_KEY=
GROQ_API_KEY=

# Speech
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_API_KEY=
BHASHINI_API_KEY=
ELEVENLABS_API_KEY=

# Optional cloud / observability (only if an example uses them)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
GRAFANA_CLOUD_API_TOKEN=

# Daily / Twilio (other examples)
DAILY_API_KEY=
DAILY_DOMAIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
